      "par",
      "applyId",
      "applicationId",
      "cardApplyNo",
      "mobileCardNo",
      "mobileCardCVC",
      "mobileCardPar",
      "mobileCardExpiryDate"
    ]
  },
  "randomFields": {
    "ci": {
      "type": "token",
      "length": 88,
      "prefix": "KONAPL",
      "charset": "alphanumeric",
      "_note": "length is the TOTAL length including prefix (sample CI was 88 chars)"
    },
    "loginId": {
      "type": "email",
      "localLength": 8,
      "domain": "yahoo.com",
      "charset": "lower_alphanumeric"
    },
    "email": {
      "type": "email",
      "localLength": 9,
      "domain": "yahoo.com",
      "charset": "lower_alphanumeric"
